# Image generation provider: "gemini" | "openai" | "replicate"
IMAGE_PROVIDER=openai

# ── Gemini (Imagen) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional: override model (default: imagen-3.0-generate-002)
GEMINI_MODEL=imagen-3.0-generate-002

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: override model (default: gpt-image-1)
OPENAI_MODEL=gpt-image-1
# Optional: image size (default: 1024x1024)
OPENAI_SIZE=1024x1024

# ── Replicate ────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=
# Optional: model version hash (default: stability-ai/sdxl latest)
REPLICATE_MODEL_VERSION=7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd72c532b815
# Optional: img2img denoising strength 0.0-1.0 (default: 0.6)
REPLICATE_IMG2IMG_STRENGTH=0.6
