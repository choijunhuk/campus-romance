# Image generation provider: "gemini" | "openai" | "replicate" | "local"
IMAGE_PROVIDER=openai

# ── Gemini (Imagen) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional: override model (default: imagen-3.0-generate-002)
GEMINI_MODEL=imagen-3.0-generate-002

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: override model (default: gpt-image-1)
OPENAI_MODEL=gpt-image-1
# Optional: image size (default: 1024x1024)
OPENAI_SIZE=1024x1024

# ── Replicate ────────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=
# Optional: model version hash (default: stability-ai/sdxl latest)
REPLICATE_MODEL_VERSION=7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd72c532b815
# Optional: img2img denoising strength 0.0-1.0 (default: 0.6)
REPLICATE_IMG2IMG_STRENGTH=0.6

# ── Local (Stable Diffusion via AUTOMATIC1111 WebUI) ──────────────────────────
# Run A1111 on the GPU box with:  webui --api --listen
# Over Tailscale, point this at the GPU box's tailscale IP (100.x.x.x):
SD_API_URL=http://127.0.0.1:7860
# Optional tuning:
SD_STEPS=28
SD_CFG=7
SD_WIDTH=832
SD_HEIGHT=1216
SD_SAMPLER=DPM++ 2M Karras
# img2img strength for expression consistency (lower = closer to base face)
SD_DENOISE=0.5
# Appended to every negative prompt:
SD_NEGATIVE_EXTRA=
