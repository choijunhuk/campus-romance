{
  "name": "campus-romance",
  "private": true,
  "version": "0.2.0",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.js",
    "build": "node scripts/validate-content.js && tsc -b && vite build",
    "preview": "vite preview",
    "gen-images": "node scripts/gen-images.js",
    "gen-images:dry": "node scripts/gen-images.js --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "story:build": "node scripts/write-story.mjs",
    "art:pack": "node scripts/prepare-art.mjs",
    "art:check": "node scripts/check-art.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
